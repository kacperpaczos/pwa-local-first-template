# Gun mesh peer(s), comma-separated. Leave empty for NoopSyncTransport (offline-only).
VITE_GUN_PEERS=http://127.0.0.1:8765/gun

# AI layer (WebLLM) is opt-in: only "true" enables it; any other value ships
# the app with AI off and the /ai page reporting "unavailable".
VITE_AI_ENABLED=false

# Optional exact WebLLM model id override; defaults to a hardware-detected
# tier (Qwen3-8B / Qwen3-4B / Llama-3.2-1B from prebuiltAppConfig).
# VITE_AI_MODEL_ID=Qwen3-4B-q4f16_1-MLC

# Set by the Playwright config, never by hand: skips SW registration and
# enables the e2e identity/AI harness hooks in dev-mode builds.
# VITE_E2E=1
