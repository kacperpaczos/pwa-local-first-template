{
  "name": "pwa-local-first-template",
  "version": "0.0.0",
  "private": true,
  "description": "Solid.js local-first PWA template (TanStack DB + outbox + Gun sync)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gun,app -c blue,green \"pnpm dev:gun-peer\" \"pnpm dev:app\"",
    "dev:app": "vite",
    "dev:gun-peer": "tsx server/gun-peer/index.ts",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:sync": "playwright test --project=chromium-sync",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "check:no-e2e-hooks": "node scripts/check-no-e2e-hooks.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "@mlc-ai/web-llm": "^0.2.84",
    "@nanostores/solid": "^1.1.1",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@solidjs/router": "^1.0.0",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.9",
    "@tanstack/db": "^0.6.17",
    "@tanstack/db-sqlite-persistence-core": "^0.2.9",
    "@tanstack/offline-transactions": "^1.0.42",
    "@tanstack/solid-db": "^0.2.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gun": "^0.2020.1241",
    "loro-crdt": "^1.13.9",
    "lucide-solid": "^1.28.0",
    "nanostores": "^1.4.2",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.9",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "3",
    "tsx": "^4.23.4",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
