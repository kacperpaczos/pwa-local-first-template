{
  "name": "pwa-local-first-template",
  "version": "0.0.0",
  "private": true,
  "description": "Solid.js local-first PWA template (TanStack DB + outbox + WS sync)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n relay,app -c blue,green \"pnpm dev:relay\" \"pnpm dev:app\"",
    "dev:app": "vite",
    "dev:relay": "tsx server/relay/index.ts",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:sync": "playwright test --project=chromium-sync",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm test:unit && pnpm test:e2e"
  },
  "license": "MIT",
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@nanostores/solid": "^1.1.1",
    "@solidjs/router": "^1.0.0",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.9",
    "@tanstack/db": "^0.6.17",
    "@tanstack/db-sqlite-persistence-core": "^0.2.9",
    "@tanstack/offline-transactions": "^1.0.42",
    "@tanstack/solid-db": "^0.2.31",
    "loro-crdt": "^1.13.9",
    "nanostores": "^1.4.2",
    "solid-js": "^1.9.9",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.4",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
